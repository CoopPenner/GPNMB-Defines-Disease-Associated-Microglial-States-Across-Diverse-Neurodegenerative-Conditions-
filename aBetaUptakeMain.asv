if ~set3

numAbSpotsCellProxNorm=nan(size(numAbSpotsCellProx));

        numAbSpotsCellProxNorm(WT)=numAbSpotsCellProx(WT) / nanmean(numAbSpotsCellProx(WT & PBS)); % this will be the number of aB spots within our radius of a nuclei

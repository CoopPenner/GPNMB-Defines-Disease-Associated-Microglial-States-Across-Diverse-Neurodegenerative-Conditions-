        numAbSpotsTotNorm(numAbSpotsTotNorm >  (nanmean(numAbSpotsTotNorm)  + 4* nanstd(numAbSpotsTotNorm) )   )   =nan;


    avgAreaAbSpotsCellProxNorm=nan(size(avgAreaAbSpotsCellProx));


        avgAreaAbSpotsCellProxNorm(WT)=avgAreaAbSpotsCellProx(WT) / nanmean(avgAreaAbSpotsCellProx(WT & PBS)); 
        avgAreaAbSpotsCellProxNorm(HET)=avgAreaAbSpotsCellProx(HET) / nanmean(avgAreaAbSpotsCellProx(HET & PBS)); 
        avgAreaAbSpotsCellProxNorm(KO1)=avgAreaAbSpotsCellProx(KO1) / nanmean(avgAreaAbSpotsCellProx(KO1 & PBS)); 


         avgAbFluoroCellProxNorm=nan(size(avgAreaAbSpotsCellProx));


        avgAbFluoroCellProxNorm(WT)=avgAbFluoroCellProx(WT) / nanmean(avgAbFluoroCellProx(WT & PBS)); 
        avgAbFluoroCellProxNorm(HET)=avgAbFluoroCellProx(HET) / nanmean(avgAbFluoroCellProx(HET & PBS)); 
        avgAbFluoroCellProxNorm(KO1)=avgAbFluoroCellProx(KO1) / nanmean(avgAbFluoroCellProx(KO1 & PBS)); 



        avgAbFluoroTotNorm=nan(size(avgAbFluoroTot)); %likewise for aB fluro

      
        avgAbFluoroTotNorm(WT)=avgAbFluoroCellProx(WT) / nanmean(avgAbFluoroTot(WT & PBS)); 
        avgAbFluoroTotNorm(HET)=avgAbFluoroCellProx(HET) / nanmean(avgAbFluoroTot(HET & PBS)); 
        avgAbFluoroTotNorm(KO1)=avgAbFluoroCellProx(KO1) / nanmean(avgAbFluoroTot(KO1 & PBS)); 



 avgAreaAbTotNorm=nan(size(avgAbFluoroTot)); %likewise for aB fluro

      
        avgAreaAbTotNorm(WT)=avgAreaAbTot(WT) / nanmean(avgAreaAbTot(WT & PBS)); 
        avgAreaAbTotNorm(HET)=avgAreaAbTot(HET) / nanmean(avgAreaAbTot(HET & PBS)); 
        avgAreaAbTotNorm(KO1)=avgAreaAbTot(KO1) / nanmean(avgAreaAbTot(KO1 & PBS)); 



else

avgAreaAbTotNorm=nan(size(avgAbFluoroTot)); %likewise for aB fluro
avgAbFluoroTotNorm=nan(size(avgAbFluoroTot)); %likewise for aB fluro
avgAbFluoroCellProxNorm=nan(size(avgAreaAbSpotsCellProx));
numAbSpotsTotNorm=nan(size(numAbSpotsTot));
avgAreaAbSpotsCellProxNorm=nan(size(numAbSpotsTot));
numAbCellProxNorm=nan(size(numAbCellProx));
numAbSpotsCellProxNorm=nan(size(numAbCellProx));
end






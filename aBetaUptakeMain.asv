        numAbSpotsTot(tt)=  (sum(aBFluoroCollectTot>= aBFluoroCutoff )   / height(nucFeaturesAtPlay)  ); % likewise with area

                T2AreaCollectTotAB(tt)=nanmean(T2AreaCollectNucAB);
